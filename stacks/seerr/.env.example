###############################

# Container runtime UID/GID passed to Docker `user:` (default image user is 1000:1000;
# ensure ${CONFIG_PATH}/seerr on the host is chowned to match PUID:PGID)
PUID=
PGID=

# Timezone (e.g. Europe/Warsaw, Etc/UTC)
TZ=

# Seerr Image Tag (latest, develop, or a specific version)
SEERR_TAG=latest

# Paths for persistent configuration (/app/config)
CONFIG_PATH=

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Container memory & Next.js RAM cache limits
SEERR_MEM_LIMIT=1G
SEERR_CACHE_SIZE=128m

# Restart policy
RESTART_POLICY=unless-stopped

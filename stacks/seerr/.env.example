# User/Group Identifiers (use: id -u / id -g)
PUID=
PGID=

# Timezone (e.g. Europe/Warsaw, UTC)
TZ=

# Seerr Image Tag (latest, develop, or a specific version)
SEERR_TAG=latest

# Paths for persistent configuration
CONFIG_PATH=

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Container memory cap
SEERR_MEM_LIMIT=1G

# Restart policy
RESTART_POLICY=unless-stopped

# User/Group Identifiers (PUID: id -u | PGID: getent group docker | cut -d: -f3) 
PUID=
PGID=

# Timezone
TZ=

# List of allowed hosts for the Homepage service 
HOMEPAGE_ALLOWED_HOSTS=

# Path to directory with config files 
CONFIG_PATH=

# Restart policy
RESTART_POLICY=unless-stopped

#  __  __            _ _                              #
# |  \/  | ___  __ _| (_) ___                         #
# | |\/| |/ _ \/ _` | | |/ _ \                        #
# | |  | |  __/ (_| | | |  __/                        #
# |_|  |_|\___|\__,_|_|_|\___|                        #
#                                                     #
#######################################################

# User/Group Identifiers (use: id -u / id -g)
PUID=
PGID=

# Timezone (e.g. Europe/Warsaw, UTC)
TZ=

# Mealie Image Tag (latest, or a specific version like v3.28.0)
MEALIE_TAG=latest

# Paths for persistent storage (/app/data will map to ${DATA_PATH}/mealie)
DATA_PATH=

# Restart policy
RESTART_POLICY=unless-stopped

# Core & Network Settings
# Full public URL without trailing slash (e.g. https://mealie.example.com)
BASE_URL=

# Registration (Set to false after initial admin user setup)
ALLOW_SIGNUP=false

# Default Group & Household names
DEFAULT_GROUP=Home
DEFAULT_HOUSEHOLD=Family

# Scheduled daily maintenance tasks (HH:MM in server local time)
DAILY_SCHEDULE_TIME=23:45

# Logging level (debug, info, warning, error, critical)
LOG_LEVEL=info

# SQLite Database Settings
# Set to true to switch SQLite journal mode to WAL for better concurrency
SQLITE_MIGRATE_JOURNAL_WAL=false

# Security & Brute-force Protection
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_USER_LOCKOUT_TIME=24

# Email / SMTP Settings (Optional - required for notifications & password reset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM_NAME=Mealie
# SMTP_FROM_EMAIL=mealie@example.com
# SMTP_AUTH_STRATEGY=TLS
# SMTP_USER=
# SMTP_PASSWORD=

# OpenID Connect / SSO Settings (Optional)
# OIDC_AUTH_ENABLED=false
# OIDC_SIGNUP_ENABLED=true
# OIDC_CONFIGURATION_URL=https://auth.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik
# OIDC_AUTO_REDIRECT=false
# OIDC_REMEMBER_ME=false


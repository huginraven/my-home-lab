# User/Group Identifiers (use: id -u / id -g)
PUID=
PGID=
UMASK=002

# Timezone (e.g. Europe/Warsaw, UTC)
TZ=

# Prowlarr Image Tag (latest, develop, or a specific version)
PROWLARR_TAG=latest

# Paths for persistent configuration
CONFIG_PATH=

# Container memory cap
PROWLARR_MEM_LIMIT=512M

# Restart policy
RESTART_POLICY=unless-stopped

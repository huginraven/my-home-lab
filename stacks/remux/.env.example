#######################################################

# User/Group Identifiers (use: id -u / id -g)
PUID=
PGID=

# Timezone (e.g. Europe/Warsaw, UTC)
TZ=

# Remux Image Tag (latest, nightly)
REMUX_TAG=latest

# Base path for persistent data (/data will map to ${DATA_PATH}/remux)
DATA_PATH=

# Restart policy
RESTART_POLICY=unless-stopped

# Optional Server & Hardware Settings
# Logging verbosity (trace, debug, info, warn, error)
# RUST_LOG=info

# Host render group ID for /dev/dri GPU transcoding (check with: getent group render)
# RENDER_GID=105


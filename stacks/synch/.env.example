#######################################################

# Timezone
TZ=Europe/Warsaw

# Paths for persistent storage
DATA_PATH=

# Public URL (must match your reverse proxy domain exactly, no trailing slash)
# Example: https://synch.yourdomain.com
PUBLIC_URL=

# Two independent random secrets for authentication and sync tokens
# Generate each on Linux/macOS with: openssl rand -hex 32
BETTER_AUTH_SECRET=
SYNC_TOKEN_SECRET=

# Comma-separated allowlist of email addresses permitted to sign up
# Example: myemail@example.com
AUTH_ALLOWED_EMAILS=

# Restart policy
RESTART_POLICY=unless-stopped

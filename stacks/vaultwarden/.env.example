#                                                              #
################################################################

# Timezone
TZ=

# Restart policy
RESTART_POLICY=unless-stopped

# Paths for persistent data
DATA_PATH=

# Vaultwarden Core Settings
# Full URL with protocol (https://), no trailing slash (e.g. https://vault.example.com)
DOMAIN=
# Set SIGNUPS_ALLOWED to false after creating your initial user
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true

# Admin panel token (Use Argon2 hash, generate with: docker run --rm -it vaultwarden/server /vaultwarden hash)
# Note: In docker-compose / .env files, each '$' in the Argon2 hash MUST be escaped as '$$'
ADMIN_TOKEN=

# Logging & Proxy Settings
LOG_FILE=/data/vaultwarden.log
LOG_LEVEL=info
EXTENDED_LOGGING=true
IP_HEADER=X-Forwarded-For

# SMTP Email Settings (Optional)
# SMTP_SECURITY options: starttls (port 587), force_tls (port 465), or off
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vaultwarden@example.com
# SMTP_FROM_NAME=Vaultwarden
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

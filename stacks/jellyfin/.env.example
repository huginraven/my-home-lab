# User/Group Identifiers (use: id -u / id -g)
PUID=
PGID=

# Timezone (e.g. Europe/Warsaw, UTC)
TZ=

# Jellyfin Image Tag (latest, or a specific version)
JELLYFIN_TAG=latest

# Paths to config and media libraries
CONFIG_PATH=
DATA_PATH=

# Public reverse proxy URL (include https://, e.g. https://jellyfin.example.com)
JELLYFIN_PUBLISHED_SERVER_URL=

# Resource & RAM-disk limits tuned for Oracle Cloud Ampere (4 OCPU / 24 GB RAM)
# Note: JELLYFIN_MEM_LIMIT includes JELLYFIN_TRANSCODE_SIZE under cgroups v2
JELLYFIN_CPU_LIMIT=3.5
JELLYFIN_MEM_LIMIT=8G
JELLYFIN_TRANSCODE_SIZE=4g

# Restart policy
RESTART_POLICY=unless-stopped

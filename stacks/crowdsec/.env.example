# User/Group Identifiers (use id command)
PGID=

# Custom hostname for CrowdSec alerts
HOSTNAME=

# CrowdSec LAPI Bouncer Key for SWAG (generate with: docker exec crowdsec cscli bouncers add swag-bouncer)
CROWDSEC_API_KEY=

# Paths for configuration, data and log inspection
CONFIG_PATH=
DATA_PATH=
LOG_PATH=

# Restart policy
RESTART_POLICY=unless-stopped

# | |_| |  __/ (__| |_| | |_) | | | | (_| | |  | |    #
# |____/ \___|\___|\__, | .__/|_| |_|\__,_|_|  |_|    #
#                  |___/|_|                           #
#                                                     #
#######################################################

# User/Group Identifiers (use: id -u / id -g)
PUID=
PGID=
UMASK=002

# Timezone (e.g. Europe/Warsaw, UTC)
TZ=

# Decypharr Image Tag (latest, beta)
DECYPHARR_TAG=latest

# Paths to config (/app) and shared media/mount directories
CONFIG_PATH=
DATA_PATH=

# Resource & RAM-disk limits for DFS streaming cache
# Note: DECYPHARR_MEM_LIMIT includes DECYPHARR_CACHE_SIZE under cgroups v2.
# Set DFS Cache Directory to /cache and Disk Cache Size to 3GB inside Decypharr UI.
DECYPHARR_MEM_LIMIT=6G
DECYPHARR_CACHE_SIZE=4g

# Restart policy
RESTART_POLICY=unless-stopped

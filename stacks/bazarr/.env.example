# User/Group Identifiers (use: id -u / id -g)
PUID=
PGID=
UMASK=002

# Timezone (e.g. Europe/Warsaw, UTC)
TZ=

# Bazarr Image Tag (latest, development, or a specific version)
BAZARR_TAG=latest

# Paths to config and shared media/mount directories
CONFIG_PATH=
DATA_PATH=

# Container memory cap
BAZARR_MEM_LIMIT=1G

# Restart policy
RESTART_POLICY=unless-stopped

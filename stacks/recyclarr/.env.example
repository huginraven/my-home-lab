# User/Group Identifiers (use id command)
PUID=
PGID=

# Timezone
TZ=

# Paths for persistent configuration
CONFIG_PATH=

# Cron schedule (defaults to @daily if empty)
CRON_SCHEDULE=

# Restart policy
RESTART_POLICY=unless-stopped

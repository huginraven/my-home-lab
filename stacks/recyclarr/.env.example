#################################################

# Container runtime UID/GID passed to Docker `user:` (non-root;
# ensure ${CONFIG_PATH}/recyclarr on the host exists and is chowned to match PUID:PGID)
PUID=
PGID=

# Timezone (e.g. Europe/Warsaw, UTC)
TZ=

# Recyclarr Image Tag (major version only, e.g. 8 - `latest` is not published since v8)
RECYCLARR_TAG=8

# Paths for persistent configuration (recyclarr.yml lives in ${CONFIG_PATH}/recyclarr)
CONFIG_PATH=

# Cron schedule for automatic sync (defaults to @daily if empty)
CRON_SCHEDULE=@daily

# Container memory cap
RECYCLARR_MEM_LIMIT=512M

# Restart policy
RESTART_POLICY=unless-stopped
